rules_version = '2';
// Regole di sicurezza del database Tukiki Allenamenti
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Profilo: ognuno legge e scrive solo il proprio
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Nome utente -> email, serve per entrare con il nome utente.
    // Si può leggere un nome alla volta, mai l'elenco completo.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // chi elimina il proprio account libera anche il nome utente
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Esercizi: tutti gli allenatori li vedono, solo l'autore li modifica
    match /exercises/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Squadre: le vede e le modifica chi le ha create e gli allenatori invitati (members).
    // Solo chi l'ha creata invita o toglie allenatori ed elimina la squadra; chi è invitato può uscire.
    function member(d) { return request.auth.uid == d.ownerId || request.auth.uid in d.get('members', []); }
    match /teams/{id} {
      allow read: if signedIn() && member(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && request.resource.data.ownerId == resource.data.ownerId && (
                      resource.data.ownerId == request.auth.uid
                      || (request.auth.uid in resource.data.get('members', [])
                          && request.resource.data.members == resource.data.members)
                      || (request.auth.uid in resource.data.get('members', [])
                          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Allenamenti: li vedono e modificano gli allenatori della loro squadra.
    // L'elenco members deve coincidere con quello della squadra (o essere solo chi l'ha creato).
    function teamMembers(tid) { return get(/databases/$(database)/documents/teams/$(tid)).data.members; }
    function validMembers() {
      return request.resource.data.members == [request.resource.data.ownerId]
        || (request.resource.data.teamId is string && request.resource.data.teamId != ''
            && request.resource.data.members == teamMembers(request.resource.data.teamId));
    }
    match /sessions/{id} {
      allow read, delete: if signedIn() && member(resource.data);
      // chi esce dalla squadra lascia i suoi allenamenti a chi l'ha creata
      allow update: if signedIn() && member(resource.data) && validMembers()
                    && (request.resource.data.ownerId == resource.data.ownerId
                        || request.resource.data.ownerId == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.ownerId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validMembers()
                    && request.auth.uid in request.resource.data.members;
    }
  }
}
